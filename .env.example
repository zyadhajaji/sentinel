# ─────────────────────────────────────────────────────────────────
# Sentinel Terminal — Environment Variables
# Copy this file to .env.local and fill in your values.
# For Vercel: add these in Project Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────

# ── Hyperliquid Markets tab ───────────────────────────────────────

# WalletConnect project ID — enables QR code + mobile wallet support
# Get a free ID at: https://cloud.walletconnect.com/
# Without this, only MetaMask / browser extension wallets work.
VITE_WC_PROJECT_ID=

# ── EVM RPC overrides (optional but recommended for reliability) ──

# Alchemy / Infura / etc. — prevents rate limits on default public RPC
# Arbitrum (primary — Hyperliquid USDC deposits go through Arbitrum bridge)
VITE_ARBITRUM_RPC=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Ethereum mainnet (for ENS + wallet identity)
VITE_MAINNET_RPC=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── App mode ──────────────────────────────────────────────────────

# Set to "demo" for the demo/showcase Vercel deployment
# Enables pre-filled balance, DEMO badge, demo localStorage prefix
VITE_APP_MODE=
